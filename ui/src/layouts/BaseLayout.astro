---
/**
 * BaseLayout: every public page. The club green header, the page's main
 * content, then the green footer.
 */
import "../styles/site.css";
import SiteFooter from "../components/ui/SiteFooter.astro";
import SiteHeader from "../components/ui/SiteHeader.astro";
import { club } from "../config";

interface Props {
	/** The page title, before " · Hough Green Park Bowls Club". */
	title: string;
	description: string;
	/** The nav item to mark as the current page. */
	current?: "Home" | "What's on" | "News" | "Find us";
	/** Keep the page out of search engines (the 404 page). */
	noindex?: boolean;
}

const { title, description, current, noindex = false } = Astro.props;
const fullTitle =
	current === "Home"
		? "Hough Green Park Bowls Club"
		: `${title} · Hough Green Park Bowls Club`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<!-- Marks that scripts run, so the phone menu can fold away without hiding the nav from anyone without them. -->
		<script is:inline>document.documentElement.classList.add("js");</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<link rel="icon" type="image/svg+xml" href="/logos/hgb-roundel-green.svg" />
		<link rel="preload" href="/fonts/atkinson-hyperlegible-next-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/atkinson-hyperlegible-next-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:rounded-md focus:bg-card focus:px-4 focus:py-2 focus:text-primary">Skip to content</a>
		<SiteHeader current={current} />
		<main id="main">
			<slot />
		</main>
		<SiteFooter email={club.email} phone={club.phone} facebook={club.facebook} />
	</body>
</html>
