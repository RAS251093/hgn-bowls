---
import { getImage } from "astro:assets";
// The admin area: one page with two views, the list of news posts and the
// editor (?post=<id>). Moving between them never reloads the page, because
// tokens live in memory and a reload means a trip through Auth0.
// Everything happens in the browser: the page signs the admin in, then
// reads and saves posts through the API with their token. The HTML is the
// same for everyone and holds no data; post text is only ever set as text.
import {
	ArrowLeft,
	Bold,
	Heading2,
	Heading3,
	ImagePlus,
	Italic,
	Link,
	List,
	ListOrdered,
	LogOut,
	Plus,
	TextQuote,
	Trash,
} from "@lucide/astro";
import defaultCover from "../assets/two-crown-green-bowls.jpg";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import Field from "../components/ui/Field.astro";
import PostRow from "../components/ui/PostRow.astro";
import { proseClass } from "../components/ui/prose";
import StatusBadge from "../components/ui/StatusBadge.astro";
import AdminLayout from "../layouts/AdminLayout.astro";
import { limits } from "../lib/admin/draft";
import { editHref } from "../lib/admin/posts";

// The club photo the site shows for a post without a cover, small enough
// for the list's thumbnails (twice their size, for sharp screens).
const defaultThumbnail = await getImage({
	src: defaultCover,
	width: 224,
	height: 152,
	fit: "cover",
	format: "webp",
});

// What the API accepts for a cover (api/media/media.go).
const imageTypes = "image/jpeg,image/png,image/webp";

// Admins add events in Google Calendar itself, signed in as the club.
const googleCalendar = "https://calendar.google.com/calendar/r";

const tools = [
	{ action: "h2", label: "Subheading", icon: Heading2 },
	{ action: "h3", label: "Small subheading", icon: Heading3 },
	{ action: "bold", label: "Bold", icon: Bold },
	{ action: "italic", label: "Italic", icon: Italic },
	{ action: "link", label: "Link", icon: Link },
	{ action: "bulletList", label: "Bulleted list", icon: List },
	{ action: "orderedList", label: "Numbered list", icon: ListOrdered },
	{ action: "quote", label: "Quote", icon: TextQuote },
];
const tool =
	"inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-md px-3 text-label text-primary transition-colors duration-120 hover:bg-secondary aria-pressed:bg-secondary aria-pressed:text-primary [&_svg]:size-5";
---

<AdminLayout title="News posts">
	<div slot="header" class="flex flex-wrap items-center gap-x-6 gap-y-2">
		<span data-signed-in-as hidden class="text-body-sm text-primary-muted-foreground"></span>
		<a href="/" class="inline-flex min-h-11 items-center text-body-sm text-primary-foreground underline">View website</a>
		<Button variant="outline" size="sm" data-sign-out hidden>
			<LogOut size={20} aria-hidden="true" />
			Sign out
		</Button>
	</div>

	<p data-state="loading" role="status" class="m-0 text-body-md text-muted-foreground">Signing you in…</p>

	<div data-state="not-admin" hidden class="flex flex-col gap-6">
		<h1 class="m-0 text-heading-xl text-primary">Club admin</h1>
		<Callout variant="error">Your account isn't set up as a club admin yet. Ask the committee to add you, then sign in again.</Callout>
	</div>

	<!-- The list of posts. -->
	<section data-view="list" hidden class="flex flex-col gap-6">
		<div class="flex flex-wrap items-center justify-between gap-4">
			<h1 class="m-0 text-heading-xl text-primary">News posts</h1>
			<Button href={editHref()} data-ready hidden><Plus aria-hidden="true" />Write a post</Button>
		</div>
		<div data-list-loading>
			<p role="status" class="sr-only">Loading the posts</p>
			<!-- Placeholder rows the shape of PostRow, still, as nothing on the site loops. -->
			<ul aria-hidden="true" class="m-0 flex list-none flex-col gap-3 p-0">
				{
					["w-3/5", "w-2/5", "w-2/3"].map((width) => (
						<li class="flex items-center gap-4 rounded-lg border border-border bg-card px-5 py-4">
							<div class="flex flex-1 flex-col gap-2">
								<div class:list={["h-7 rounded-sm bg-secondary", width]} />
								<div class="flex gap-3">
									<div class="h-6 w-24 rounded-sm bg-secondary" />
									<div class="h-6 w-32 rounded-sm bg-secondary" />
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</div>
		<div data-list-error hidden>
			<Callout variant="error">We couldn't load the posts. Check your connection, then reload the page.</Callout>
		</div>
		<div data-ready hidden class="flex flex-col gap-6">
			<Callout variant="info">
				<strong class="font-semibold">Adding an event?</strong> Events come straight from the club's Google Calendar, so add them there as usual.
				<a slot="action" class="inline-flex min-h-11 items-center text-label text-info-foreground underline" href={googleCalendar}>Open Google Calendar</a>
			</Callout>
			<ul data-list data-default-thumbnail={defaultThumbnail.src} aria-label="Posts" class="m-0 flex list-none flex-col gap-3 p-0"></ul>
			<p data-empty hidden class="m-0 rounded-md bg-secondary px-6 py-5">No news posts yet. Write a post to tell members what's happening at the club.</p>
		</div>
	</section>

	<!-- The editor. -->
	<section data-view="edit" hidden class="flex max-w-measure flex-col gap-6">
		<a href="/admin" class="inline-flex min-h-11 items-center gap-2 self-start text-label text-primary underline">
			<ArrowLeft size={20} aria-hidden="true" />All posts
		</a>
		<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
			<h1 data-editor-heading class="m-0 text-heading-xl text-primary">Edit post</h1>
			<p data-save-status role="status" class="m-0 text-body-sm text-muted-foreground"></p>
		</div>
		<div data-conflict hidden>
			<Callout variant="error">Someone else has changed this post since you opened it, so your latest changes aren't saved. Copy anything you want to keep, then reload the page to see their version.</Callout>
		</div>
		<div data-editor-error hidden>
			<Callout variant="error">We couldn't open this post. Check your connection, then reload the page.</Callout>
		</div>

		<div data-editor-loading hidden>
			<p role="status" class="sr-only">Loading the post</p>
			<!-- Placeholders the shape of the form below, still, as nothing on the site loops. -->
			<div aria-hidden="true" class="flex flex-col gap-6">
				<div class="flex flex-col gap-2">
					<div class="h-6 w-24 rounded-sm bg-secondary" />
					<div class="h-12 rounded-md bg-secondary" />
				</div>
				<div class="flex flex-col gap-2">
					<div class="h-6 w-28 rounded-sm bg-secondary" />
					<div class="h-30 rounded-md bg-secondary" />
				</div>
				<div class="flex flex-col gap-2">
					<div class="h-6 w-16 rounded-sm bg-secondary" />
					<div class="h-80 rounded-md bg-secondary" />
				</div>
			</div>
		</div>

		<form data-editor-form hidden novalidate class="flex flex-col gap-6">
			<Field id="post-title" name="title" label="Headline" help={`Up to ${limits.title} characters.`} autocomplete="off" liveErrors />
			<Field id="post-description" name="description" label="Description" help={`A sentence or two, shown under the headline and on the news page. Up to ${limits.description} characters.`} multiline rows={3} liveErrors />

			<fieldset data-cover aria-describedby="cover-help" class="m-0 flex min-w-0 flex-col gap-3 border-0 p-0">
				<legend class="mb-2 p-0 text-label">Cover photo</legend>
				<p id="cover-help" class="m-0 text-body-sm text-muted-foreground">Optional. Shown at the top of the post and on the news page; without one, the club's photo of the green is used. A JPEG, PNG or WebP photo up to 10 MB.</p>
				<div data-cover-set hidden class="flex flex-col gap-4">
					<img data-cover-image alt="" class="aspect-video w-full rounded-lg bg-secondary object-cover" />
					<p data-cover-unavailable hidden class="m-0 rounded-lg bg-secondary px-6 py-5 text-body-sm text-muted-foreground">This post has a cover photo, but it can't be shown right now. It's still saved with the post.</p>
					<Field id="cover-alt" label="Describe the photo" help={`For people who can't see it, for example: Two members bowling on a sunny afternoon. Up to ${limits.coverAlt} characters.`} autocomplete="off" liveErrors />
					<div class="flex flex-wrap gap-3">
						<Button as="label" variant="outline" size="sm">
							<ImagePlus aria-hidden="true" />Change photo
							<input type="file" data-cover-file accept={imageTypes} class="sr-only" />
						</Button>
						<Button variant="outline" size="sm" data-cover-remove><Trash aria-hidden="true" />Remove photo</Button>
					</div>
				</div>
				<div data-cover-empty class="flex">
					<Button as="label" variant="outline" size="sm">
						<ImagePlus aria-hidden="true" />Add a cover photo
						<input type="file" data-cover-file accept={imageTypes} class="sr-only" />
					</Button>
				</div>
				<p data-cover-uploading role="status" hidden class="m-0 text-body-sm text-muted-foreground">Uploading the photo…</p>
				<p data-cover-error role="alert" hidden class="m-0 text-body-sm font-medium text-destructive"></p>
			</fieldset>

			<div class="group flex flex-col gap-2">
				<span id="post-body-label" class="text-label group-has-[[aria-invalid=true]]:text-destructive">Post</span>
				<div class="focus-ring-within-editor rounded-md border-control border-input bg-card transition-colors duration-120 hover:border-primary has-[[aria-invalid=true]]:border-destructive">
					<div role="toolbar" aria-label="Formatting" aria-controls="post-body" class="sticky top-0 z-10 flex flex-wrap gap-1 rounded-t-md border-b border-border bg-card p-2">
						{
							tools.map(({ action, label, icon: Icon }) => (
								<button type="button" data-tool={action} aria-pressed="false" class={tool}>
									<Icon aria-hidden="true" />
									{label}
								</button>
							))
						}
					</div>
					<div data-link-form hidden class="flex flex-wrap items-end gap-3 border-b border-border bg-secondary p-3">
						<Field id="post-link" label="Link address" type="url" inputmode="url" autocomplete="off" class="min-w-60 flex-1" />
						<div class="flex gap-2">
							<Button size="sm" data-link-add>Add link</Button>
							<Button size="sm" variant="outline" data-link-remove>Remove link</Button>
							<Button size="sm" variant="outline" data-link-cancel>Cancel</Button>
						</div>
					</div>
					<div data-editor-mount data-prose={proseClass}></div>
				</div>
				<p id="post-body-error" data-body-error hidden class="m-0 text-body-sm font-medium text-destructive"></p>
			</div>
		</form>
	</section>

	<template data-row><PostRow title="" status="draft" meta="" editHref="" /></template>
	<template data-badge="draft"><StatusBadge status="draft" /></template>
	<template data-badge="published"><StatusBadge status="published" /></template>
</AdminLayout>

<script>
	import { start } from "../lib/admin/app";

	void start();
</script>
