---
// The admin home: the club's news posts. Everything here happens in the
// browser: the page signs the admin in with Auth0, then reads the posts
// from the API with their token. The HTML is the same for everyone and
// holds no data; post titles are only ever set as text.
import { LogOut, Plus } from "@lucide/astro";
import Button from "../components/ui/Button.astro";
import Callout from "../components/ui/Callout.astro";
import PostRow from "../components/ui/PostRow.astro";
import StatusBadge from "../components/ui/StatusBadge.astro";
import AdminLayout from "../layouts/AdminLayout.astro";
import { editHref } from "../lib/admin/posts";

// Admins add events in Google Calendar itself, signed in as the club.
const googleCalendar = "https://calendar.google.com/calendar/r";
---

<AdminLayout title="News posts">
	<div slot="header" class="flex flex-wrap items-center gap-x-6 gap-y-2">
		<span data-signed-in-as hidden class="text-body-sm text-primary-muted-foreground"></span>
		<a href="/" class="inline-flex min-h-11 items-center text-body-sm text-primary-foreground underline">View website</a>
		<Button variant="outline" size="sm" data-sign-out hidden>
			<LogOut size={20} aria-hidden="true" />
			Sign out
		</Button>
	</div>

	<div class="flex flex-wrap items-center justify-between gap-4">
		<h1 class="m-0 text-heading-xl text-primary">News posts</h1>
		<Button href={editHref()} data-ready hidden><Plus aria-hidden="true" />Write a post</Button>
	</div>

	<p data-state="loading" role="status" class="m-0 text-body-md text-muted-foreground">Signing you in…</p>

	<div data-state="ready" hidden class="flex flex-col gap-6">
		<Callout variant="info">
			<strong class="font-semibold">Adding an event?</strong> Events come straight from the club's Google Calendar, so add them there as usual.
			<a slot="action" class="inline-flex min-h-11 items-center text-label text-info-foreground underline" href={googleCalendar}>Open Google Calendar</a>
		</Callout>
		<ul data-list aria-label="Posts" class="m-0 flex list-none flex-col gap-3 p-0"></ul>
		<p data-empty hidden class="m-0 rounded-md bg-secondary px-6 py-5">No news posts yet. Write a post to tell members what's happening at the club.</p>
	</div>

	<div data-state="not-admin" hidden>
		<Callout variant="error">Your account isn't set up as a club admin yet. Ask the committee to add you, then sign in again.</Callout>
	</div>

	<div data-state="error" hidden>
		<Callout variant="error">We couldn't load the posts. Check your connection, then reload the page.</Callout>
	</div>

	<template data-row><PostRow title="" status="draft" meta="" editHref="" /></template>
	<template data-badge="draft"><StatusBadge status="draft" /></template>
	<template data-badge="published"><StatusBadge status="published" /></template>
</AdminLayout>

<script>
	import { apiUrl } from "../config";
	import { apiClient, SignInRequired } from "../lib/admin/api";
	import { type AdminPost, editHref, metaLine } from "../lib/admin/posts";
	import { startSession } from "../lib/admin/session";

	const show = (state: string) => {
		for (const el of document.querySelectorAll<HTMLElement>("[data-state]")) {
			el.hidden = el.dataset.state !== state;
		}
	};

	function template(selector: string): DocumentFragment {
		const t = document.querySelector<HTMLTemplateElement>(`template${selector}`);
		if (!t) throw new Error(`admin: missing template ${selector}`);
		return t.content.cloneNode(true) as DocumentFragment;
	}

	function row(post: AdminPost): DocumentFragment {
		const li = template("[data-row]");
		const link = li.querySelector<HTMLAnchorElement>("[data-title]");
		if (link) {
			link.textContent = post.title;
			link.href = editHref(post.id);
		}
		li.querySelector("[data-status]")?.replaceChildren(
			template(`[data-badge="${post.status === "published" ? "published" : "draft"}"]`),
		);
		const meta = li.querySelector("[data-meta]");
		if (meta) meta.textContent = metaLine(post);
		return li;
	}

	function showPosts(posts: AdminPost[]) {
		const list = document.querySelector<HTMLUListElement>("[data-list]");
		const empty = document.querySelector<HTMLElement>("[data-empty]");
		if (!list || !empty) return;
		list.replaceChildren(...posts.map(row));
		list.hidden = posts.length === 0;
		empty.hidden = posts.length > 0;
		for (const el of document.querySelectorAll<HTMLElement>("[data-ready]")) {
			el.hidden = false;
		}
		show("ready");
	}

	async function main() {
		const session = await startSession();
		if (!session) return; // on the way to Auth0

		const signOut = document.querySelector<HTMLButtonElement>("[data-sign-out]");
		if (signOut) {
			signOut.hidden = false;
			signOut.addEventListener("click", () => {
				signOut.disabled = true;
				void session.signOut();
			});
		}
		const who = document.querySelector<HTMLElement>("[data-signed-in-as]");
		if (who) {
			who.textContent = session.name;
			who.hidden = false;
		}

		const api = apiClient(apiUrl, session);
		const res = await api("/api/admin/posts");
		if (res.status === 403) return show("not-admin");
		if (!res.ok) return show("error");
		const { posts } = (await res.json()) as { posts: AdminPost[] };
		showPosts(posts);
	}

	main().catch((err) => {
		if (err instanceof SignInRequired) return;
		console.error(err);
		show("error");
	});
</script>
