---
/**
 * PostRow: one news post in the admin list. The whole row is the link to
 * edit it; deleting happens in the editor, never one slip away on a list.
 * The data- hooks let a page clone it from a <template> and fill it in the
 * browser. Guide: design-system/components/PostRow.md
 */
import { ChevronRight } from "@lucide/astro";
import StatusBadge from "./StatusBadge.astro";

interface Props {
	title: string;
	status: "published" | "draft";
	/** e.g. "Published 18 April" or "Last edited 14:32". */
	meta: string;
	editHref: string;
	/** The cover, small; decorative, as the title names the post. */
	thumbnail?: string;
}

const { title, status, meta, editHref, thumbnail } = Astro.props;
---

<li class="group relative flex items-center gap-4 rounded-lg border border-border bg-card px-5 py-4 transition-colors duration-120 hover:border-input focus-ring-within-link">
	<img data-thumbnail src={thumbnail} alt="" width="112" height="76" loading="lazy" decoding="async" class="h-14 w-20 shrink-0 rounded-sm bg-secondary object-cover sm:h-19 sm:w-28" />
	<div class="flex min-w-0 flex-1 flex-col gap-2">
		<a data-title href={editHref} class="text-heading-md text-primary no-underline after:absolute after:inset-0 group-hover:underline">{title}</a>
		<span class="flex flex-wrap items-center gap-3 text-body-sm text-muted-foreground">
			<span data-status class="contents"><StatusBadge status={status} /></span>
			<span data-meta>{meta}</span>
		</span>
	</div>
	<ChevronRight size={20} aria-hidden="true" class="shrink-0 text-muted-foreground" />
</li>
