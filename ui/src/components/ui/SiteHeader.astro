---
/**
 * SiteHeader: the club green bar on every public page. Sits directly above Hero so the two read as one block.
 * Below 768px the nav folds behind a Menu button so the header stays one row; without JavaScript it
 * simply stays open. Guide: design-system/components/SiteHeader.md
 */
import { Menu, X } from "@lucide/astro";
import Button from "./Button.astro";

interface Props {
	/** The current page's nav label, marked with aria-current. */
	current?: "Home" | "What's on" | "News" | "Find us" | "Join us";
}

const { current } = Astro.props;

const links = [
	{ label: "Home", href: "/" },
	{ label: "What's on", href: "/whats-on" },
	{ label: "News", href: "/news" },
	{ label: "Find us", href: "/#find-us" },
] as const;
---

<header class="on-primary">
	<div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-x-4 px-4 py-3 md:gap-y-4 md:px-6 md:py-4">
		<a href="/" class="flex items-center gap-3 text-primary-foreground no-underline">
			<img src="/logos/hgb-roundel-light.svg" alt="" width="44" height="44" class="size-11 shrink-0" />
			<span class="flex flex-col">
				<span class="text-heading-sm font-semibold">Hough Green Park</span>
				<span class="text-meta text-primary-muted-foreground">Bowls Club</span>
			</span>
		</a>
		<button
			type="button"
			data-menu-button
			aria-expanded="false"
			aria-controls="site-nav"
			class="menu-button hidden min-h-11 cursor-pointer items-center gap-2 rounded-md border-control border-accent bg-transparent px-4 text-label text-primary-foreground transition-colors duration-120 hover:bg-primary-hover"
		>
			<Menu size={20} aria-hidden="true" data-icon-open />
			<X size={20} aria-hidden="true" data-icon-close class="hidden" />
			Menu
		</button>
		<nav
			id="site-nav"
			aria-label="Main"
			class="site-nav flex w-full flex-col pt-2 pb-3 md:w-auto md:flex-row md:flex-wrap md:items-center md:gap-x-6 md:gap-y-1 md:p-0"
		>
			{
				links.map((link) => (
					<a
						href={link.href}
						aria-current={current === link.label ? "page" : undefined}
						class="inline-flex min-h-11 items-center self-start border-b-3 border-transparent text-label text-primary-foreground no-underline transition-colors duration-120 hover:border-primary-muted-foreground aria-[current=page]:border-accent md:self-auto"
					>
						{link.label}
					</a>
				))
			}
			<Button
				variant="accent"
				size="sm"
				href="/join"
				class="mt-3 w-full md:mt-0 md:w-auto"
				aria-current={current === "Join us" ? "page" : undefined}
			>
				Join us
			</Button>
		</nav>
	</div>
</header>

<style>
	/* Phones with JavaScript: show the Menu button and fold the nav behind it. */
	@media (max-width: 47.99rem) {
		:global(.js) .menu-button {
			display: inline-flex;
		}
		:global(.js) .site-nav:not([data-open]) {
			display: none;
		}
	}
</style>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>("[data-menu-button]")) {
		const nav = document.getElementById(button.getAttribute("aria-controls") ?? "");
		if (!nav) continue;

		const setOpen = (open: boolean) => {
			button.setAttribute("aria-expanded", String(open));
			nav.toggleAttribute("data-open", open);
			button.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
			button.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
		};

		button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
		nav.addEventListener("click", (event) => {
			// A link to a section of this page (Find us) shouldn't leave the menu covering it.
			if ((event.target as Element).closest("a")) setOpen(false);
		});
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
				setOpen(false);
				button.focus();
			}
		});
	}
</script>
