---
import { Image } from "astro:assets";
/**
 * NewsCard: a club news teaser. The whole card is clickable through the headline link.
 * Place cards in a `grid gap-8 sm:grid-cols-2 lg:grid-cols-3` on a `bg-secondary` band.
 * The photo is decorative here (the headline names the post). A remote `image` (a post's
 * signed cover link) is downloaded and resized at build time.
 * Guide: design-system/components/NewsCard.md
 */
import type { ImageMetadata } from "astro";

interface Props {
	href: string;
	title: string;
	/** Already written out, e.g. "Friday 3 April". */
	date: string;
	/** For the datetime attribute. */
	dateTime: string;
	image: ImageMetadata | string;
	description?: string;
	/** Heading level of the headline: 3 under a section heading, 2 when the cards are the page's main list. */
	level?: 2 | 3;
}

const {
	href,
	title,
	date,
	dateTime,
	image,
	description,
	level = 3,
} = Astro.props;
const Heading = `h${level}` as const;
const remote = typeof image === "string";
// Explicit sizes, cropped to 3:2: a remote cover's own size would otherwise carry through.
const sizing = {
	width: 720,
	height: 480,
	fit: "cover" as const,
	widths: [360, 560, 720],
	sizes: "(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw",
	class: "block aspect-3/2 w-full object-cover",
};
---

<article class="group relative flex flex-col overflow-hidden rounded-lg border border-border bg-card transition-colors duration-120 hover:border-input">
	{remote ? <Image src={image} inferSize alt="" {...sizing} /> : <Image src={image} alt="" {...sizing} />}
	<div class="flex flex-col gap-2 px-6 pt-5 pb-6">
		<p class="m-0 text-meta text-meta-foreground"><time datetime={dateTime}>{date}</time></p>
		<Heading class="m-0 text-heading-md">
			<a href={href} class="text-primary no-underline after:absolute after:inset-0 group-hover:underline">{title}</a>
		</Heading>
		{description && <p class="m-0 text-muted-foreground">{description}</p>}
	</div>
</article>
