---
/** MembershipCard: one membership price. Place in a `grid gap-6 md:grid-cols-3` on `bg-secondary`. Guide: design-system/components/MembershipCard.md */
interface Props {
	name: string;
	price: string;
	note: string;
}

const { name, price, note } = Astro.props;
---

<div class="flex flex-col gap-2 rounded-lg border border-border bg-card p-6">
	<h3 class="m-0 text-heading-md text-primary">{name}</h3>
	<p class="m-0 text-heading-xl text-primary tabular-nums lining-nums">{price}</p>
	<p class="m-0 text-muted-foreground">{note}</p>
</div>
