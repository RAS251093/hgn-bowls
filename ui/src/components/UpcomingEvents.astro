---
/**
 * UpcomingEvents: the club calendar, fetched from GET /api/events in the
 * browser so it's never older than a minute. It renders the EventList
 * design (green date tiles, full-width rules) with loading, empty, stale and
 * error states. Event text is only ever set as text, never as HTML.
 */
import { apiUrl, calendarLinks } from "../config";

interface Props {
	/** How many events to show. */
	limit: number;
	/** Group events under month headings (h2), as on What's on. */
	byMonth?: boolean;
}

const { limit, byMonth = false } = Astro.props;
const skeletonRows = Math.min(limit, 4);
---

<div data-events data-api={apiUrl} data-limit={limit} data-by-month={byMonth ? "true" : undefined} aria-live="polite" aria-busy="true" class="flex flex-col gap-12">
	<ul data-loading class="m-0 list-none border-t border-border p-0" aria-label="Loading events">
		{
			Array.from({ length: skeletonRows }, () => (
				<li class="flex items-center gap-6 border-b border-border py-5" aria-hidden="true">
					<div class="h-21 w-21 shrink-0 rounded-md bg-secondary" />
					<div class="flex flex-1 flex-col gap-2">
						<div class="h-6 w-2/3 rounded-sm bg-secondary" />
						<div class="h-5 w-1/3 rounded-sm bg-secondary" />
					</div>
				</li>
			))
		}
	</ul>

	<p data-stale hidden class="m-0 rounded-md bg-secondary px-6 py-5">
		These may be out of date. We couldn't reach the club calendar just now.
	</p>
	<div data-list hidden class="flex flex-col gap-12"></div>
	<p data-empty hidden class="m-0 rounded-md bg-secondary px-6 py-5">
		Nothing on the calendar yet. <a class="text-primary underline" href={calendarLinks.open}>See the calendar in Google</a>
	</p>
	<p data-error hidden class="m-0 rounded-md bg-secondary px-6 py-5">
		We can't show the events right now. <a class="text-primary underline" href={calendarLinks.open}>See the calendar in Google</a>
	</p>

	<template data-month>
		<section class="flex flex-col gap-4">
			<h2 class="m-0 text-heading-xl text-primary"></h2>
			<ul class="m-0 list-none border-t border-border p-0"></ul>
		</section>
	</template>
	<template data-list-only>
		<ul class="m-0 list-none border-t border-border p-0"></ul>
	</template>
	<template data-row>
		<li class="flex flex-wrap items-center gap-6 border-b border-border py-5">
			<div class="flex w-21 shrink-0 flex-col rounded-md bg-primary py-2 text-center text-primary-foreground" aria-hidden="true">
				<span data-weekday class="text-meta text-accent"></span>
				<span data-day class="text-heading-lg"></span>
				<span data-month-short class="text-meta"></span>
			</div>
			<div class="flex min-w-0 flex-1 basis-48 flex-col gap-1">
				<h3 class="m-0 text-heading-md text-primary"><span data-full-date class="sr-only"></span><span data-title></span></h3>
				<p data-when class="m-0 text-muted-foreground"></p>
				<p data-description class="m-0 mt-1 whitespace-pre-line"></p>
			</div>
		</li>
	</template>
</div>

<script>
	import { type ClubEvent, fetchEvents, fullDate, groupByMonth, tile, when } from "../lib/events";

	function clone(root: Element, name: string): DocumentFragment {
		const t = root.querySelector<HTMLTemplateElement>(`template[data-${name}]`);
		if (!t) throw new Error(`events: missing template ${name}`);
		return t.content.cloneNode(true) as DocumentFragment;
	}

	function set(scope: ParentNode, name: string, text: string) {
		const el = scope.querySelector(`[data-${name}]`);
		if (el) el.textContent = text;
	}

	function row(root: Element, event: ClubEvent): DocumentFragment {
		const li = clone(root, "row");
		const t = tile(event);
		set(li, "weekday", t.weekday);
		set(li, "day", t.day);
		set(li, "month-short", t.month);
		set(li, "full-date", `${fullDate(event)}: `);
		set(li, "title", event.title);
		set(li, "when", when(event));
		if (event.description) {
			set(li, "description", event.description);
		} else {
			li.querySelector("[data-description]")?.remove();
		}
		return li;
	}

	function show(root: HTMLElement, ...names: string[]) {
		root.querySelector("[data-loading]")?.remove();
		for (const name of names) {
			root.querySelector<HTMLElement>(`[data-${name}]`)?.removeAttribute("hidden");
		}
		root.removeAttribute("aria-busy");
	}

	async function load(root: HTMLElement) {
		const limit = Number(root.dataset.limit);
		const list = root.querySelector<HTMLElement>("[data-list]");
		if (!list) return;
		try {
			const { events, stale } = await fetchEvents(root.dataset.api ?? "", limit);
			if (events.length === 0) {
				show(root, "empty");
				return;
			}
			if (root.dataset.byMonth) {
				groupByMonth(events).forEach((group, i) => {
					const section = clone(root, "month");
					const heading = section.querySelector("h2");
					const ul = section.querySelector("ul");
					if (!heading || !ul) return;
					heading.id = `month-${i}`;
					heading.textContent = group.label;
					section.querySelector("section")?.setAttribute("aria-labelledby", heading.id);
					for (const event of group.events) ul.append(row(root, event));
					list.append(section);
				});
			} else {
				const ul = clone(root, "list-only");
				const target = ul.querySelector("ul");
				for (const event of events) target?.append(row(root, event));
				list.append(ul);
			}
			show(root, ...(stale ? ["stale", "list"] : ["list"]));
		} catch {
			show(root, "error");
		}
	}

	for (const root of document.querySelectorAll<HTMLElement>("[data-events]")) {
		void load(root);
	}
</script>
