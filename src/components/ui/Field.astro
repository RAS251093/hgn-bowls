---
/**
 * Field: label, optional help, an input or textarea, and an error message.
 * Labels sit above the field; never use a placeholder as the label. Only required fields are marked.
 * Guide: design-system/components/Field.md
 */
import { CircleAlert } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";

type Props = Omit<HTMLAttributes<"input">, "id"> & {
	id: string;
	label: string;
	help?: string;
	error?: string;
	multiline?: boolean;
	rows?: number;
};

const {
	id,
	label,
	help,
	error,
	multiline = false,
	rows = 4,
	required,
	class: className,
	...rest
} = Astro.props;
const helpId = help ? `${id}-help` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [helpId, errorId].filter(Boolean).join(" ") || undefined;
const control = [
	"w-full min-h-12 rounded-md border-control bg-card p-3 text-foreground transition-colors duration-120",
	"hover:border-primary focus-visible:border-primary focus-visible:outline-offset-1",
	"disabled:cursor-not-allowed disabled:bg-disabled disabled:text-disabled-foreground disabled:border-disabled-foreground",
	error ? "border-destructive" : "border-input on-primary:border-background",
];
---

<div class:list={["flex flex-col gap-2", className]}>
	<label for={id} class:list={["text-label", error && "text-destructive on-primary:text-primary-foreground"]}>
		{label}{required && <span aria-hidden="true"> *</span>}
	</label>
	{help && <p id={helpId} class="m-0 text-body-sm text-muted-foreground on-primary:text-primary-muted-foreground">{help}</p>}
	{
		multiline ? (
			<textarea id={id} rows={rows} required={required} aria-invalid={error ? "true" : undefined} aria-describedby={describedBy} class:list={[control, "min-h-30 resize-y"]} {...(rest as HTMLAttributes<"textarea">)} />
		) : (
			<input id={id} required={required} aria-invalid={error ? "true" : undefined} aria-describedby={describedBy} class:list={control} {...rest} />
		)
	}
	{
		error && (
			<p id={errorId} class="m-0 flex items-start gap-2 text-body-sm font-medium text-destructive on-primary:self-start on-primary:rounded-sm on-primary:bg-destructive-tint on-primary:px-2 on-primary:py-1">
				<CircleAlert size={20} aria-hidden="true" class="mt-0.5 shrink-0" />
				{error}
			</p>
		)
	}
</div>
