---
import { GraphQLClient } from "graphql-request";
import BlogPost from "../layouts/BlogPost.astro";

const client = new GraphQLClient(import.meta.env.HYGRAPH_ENDPOINT);

const { articles } = await client.request(`
    query newsArticles {
        newsArticles {
            title
            slug
            body {
                text
            }
        }
    }`);
---

<BlogPost />
